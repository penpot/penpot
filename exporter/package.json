{
  "name": "exporter",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "author": "Kaleidos INC Sucursal en España SL",
  "private": true,
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "repository": {
    "type": "git",
    "url": "https://github.com/penpot/penpot"
  },
  "type": "module",
  "dependencies": {
    "@penpot/svgo": "penpot/svgo#3.3.0",
    "archiver": "8.0.0",
    "cookies": "^0.9.2",
    "date-fns": "^4.4.0",
    "generic-pool": "^3.9.0",
    "inflation": "^2.1.0",
    "ioredis": "^6.0.0",
    "playwright": "1.63.0",
    "raw-body": "^4.0.0",
    "source-map-support": "^0.5.21",
    "undici": "^8.12.3",
    "xml-js": "^1.6.11",
    "xregexp": "^5.1.3"
  },
  "devDependencies": {
    "ws": "^8.22.0"
  },
  "scripts": {
    "clear:shadow-cache": "rm -rf .shadow-cljs && rm -rf target",
    "watch:app": "pnpm run build:wasm && pnpm run clear:shadow-cache && clojure -M:dev:shadow-cljs watch main",
    "watch": "pnpm run watch:app",
    "build:app": "clojure -M:dev:shadow-cljs release main",
    "build:wasm": "../render-wasm/build export",
    "build": "pnpm run clear:shadow-cache && pnpm run build:app",
    "fmt:clj": "cljfmt fix --parallel=true src/ test/",
    "check-fmt:clj": "cljfmt check --parallel=true src/ test/",
    "lint:clj": "clj-kondo --fail-level error --parallel --lint src/ test/",
    "build:test": "clojure -M:dev:shadow-cljs compile test",
    "test": "pnpm run build:test && PENPOT_SECRET_KEY=${PENPOT_SECRET_KEY:-test-secret-key} node target/tests/test.js",
    "test:quiet": "node ./scripts/test-quiet.js"
  }
}
