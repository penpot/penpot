{
  "name": "media-processor",
  "version": "1.0.0",
  "description": "Stateless HTTP service for Penpot image and font processing",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "node dist/index.js",
    "start:dev": "tsx --env-file=../backend/scripts/_env src/index.ts",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "fmt": "prettier --write src/ test/",
    "fmt:check": "prettier --check src/ test/",
    "clean": "rm -rf dist/"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "p-queue": "^9.3.3",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
