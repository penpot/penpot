{
  "name": "media-processor",
  "version": "1.0.0",
  "description": "Stateless HTTP service for Penpot image and font processing",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "node dist/index.js",
    "start:dev": "tsx --env-file=../backend/scripts/_env src/index.ts",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "fmt": "prettier --write src/ test/",
    "fmt:check": "prettier --check src/ test/",
    "clean": "rm -rf dist/"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "p-queue": "^9.3.3",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
