{
  "name": "media-processor",
  "version": "1.0.0",
  "description": "Stateless HTTP service for Penpot image and font processing",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "node dist/index.js",
    "start:dev": "tsx --env-file=../backend/scripts/_env src/index.ts",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "fmt": "prettier --write src/ test/",
    "fmt:check": "prettier --check src/ test/",
    "clean": "rm -rf dist/"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "p-queue": "^9.3.3",
    "pino": "^10.4.0",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
