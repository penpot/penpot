#!/usr/bin/env bash
# Decodifica un blob de file_data (app.util.blob) a JSON para inspeccionar con jq.
#
# Uso offline (sin DB):
#   backend/scripts/decode-file-data --input /tmp/blob.bin --format summary | jq .
#
# Uso con DB (backend arrancado, vía nREPL):
#   ./scripts/nrepl-eval.mjs "(require '[app.scripts.decode-file-data :as dfd] :reload)"
#   ./scripts/nrepl-eval.mjs '(dfd/get-file-json sys/system #uuid "..." :format :summary)'

SCRIPT_DIR=$(dirname "$0")

source "$SCRIPT_DIR/_env"

if [ -f "$SCRIPT_DIR/_env.local" ]; then
    source "$SCRIPT_DIR/_env.local"
fi

exec clojure -M:dev -m app.scripts.decode-file-data "$@"
