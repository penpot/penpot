FROM node:26-bookworm-slim AS build
RUN npm install --global --ignore-scripts pnpm@12.5.1
WORKDIR /src/mcp
COPY mcp/ ./
RUN pnpm install --frozen-lockfile --ignore-scripts \
 && pnpm --filter mcp-common run build \
 && pnpm --filter mcp-server exec tsx --test --test-force-exit 'src/*.test.ts' \
 && pnpm --filter mcp-server run types:check \
 && pnpm exec prettier --check packages/server/src/PenpotMcpServer.ts packages/server/src/JsonResponse.test.ts \
 && pnpm --filter mcp-server run build
# Keep the deployed release's protocol, resources and dependency closure.
FROM penpotapp/mcp:2.18.0
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/myagizmaktav/penpot" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.base.name="penpotapp/mcp:2.18.0" \
      de.foxtools.patch="json-response-opt-in-20261020"
COPY --from=build /src/mcp/packages/server/dist/index.js /opt/penpot/mcp/index.js
