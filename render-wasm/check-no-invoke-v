#!/usr/bin/env bash
# Fail if the Emscripten JS glue exports invoke_*V (JS longjmp + wasm SIMD ABI).
set -euo pipefail

_SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# _build_env reads NODE_ENV without a default; keep set -u happy.
NODE_ENV=${NODE_ENV:-}
# shellcheck source=/dev/null
. "$_SCRIPT_DIR/_build_env" frontend

if [[ $# -ge 1 ]]; then
  GLUE=$1
else
  GLUE="$_SCRIPT_DIR/$FRONTEND_DEST/$BUILD_NAME.js"
fi

if [[ ! -f "$GLUE" ]]; then
  echo "error: JS glue not found: $GLUE" >&2
  echo "hint: run ./build frontend first" >&2
  exit 1
fi

status=0
grep -qE 'invoke_[A-Za-z0-9]*V' "$GLUE" || status=$?

if [[ $status -eq 0 ]]; then
  echo "error: JS glue still exports invoke_*V: $GLUE" >&2
  grep -oE 'invoke_[A-Za-z0-9]*V' "$GLUE" | sort -u >&2
  exit 1
elif [[ $status -gt 1 ]]; then
  echo "error: grep failed on $GLUE" >&2
  exit "$status"
fi
