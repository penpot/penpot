#!/usr/bin/env bash
set -x

case "$(uname -m)" in
  aarch64|arm64) _ARCH="aarch64" ;;
  *) _ARCH="x86_64" ;;
esac

export SKIA_BINARIES_URL=${SKIA_BINARIES_URL:-"https://github.com/penpot/skia-binaries/releases/download/0.153.3/skia-binaries-b7f043e0b1e2a850e702-${_ARCH}-unknown-linux-gnu-gl-svg-textlayout-binary-cache-webp-pdf.tar.gz"}
export CARGO_BUILD_TARGET=${CARGO_BUILD_TARGET:-"${_ARCH}-unknown-linux-gnu"};

_SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
pushd "$_SCRIPT_DIR" > /dev/null

. ./_build_env frontend

setup
cargo test --bin render_wasm -- --show-output

RESULT=$?
popd > /dev/null

exit $RESULT
