#kaocha/v1
{:tests [{:id :unit
          :test-paths ["test"]}]
 :kaocha/reporter [kaocha.report/dots]

 ;; Only read when the cloverage plugin is on (`:coverage` alias).
 :cloverage/opts {:src-ns-path ["src"]
                  :ns-regex ["^app\\..*"]
                  :ns-exclude-regex ["^app\\.common\\.test-helpers\\..*"]
                  :output "target/coverage"
                  :lcov? true
                  ;; EMMA XML carries the form counts the PR report shows as statements.
                  :emma-xml? true
                  :html? true
                  :summary? true
                  :codecov? false
                  :fail-threshold 0}}
