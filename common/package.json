{
  "name": "common",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "author": "Kaleidos INC Sucursal en España SL",
  "private": true,
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/penpot/penpot"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "prettier": "3.9.9",
    "source-map-support": "^0.5.21",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "date-fns": "^4.4.0"
  },
  "scripts": {
    "lint:clj": "clj-kondo --fail-level error --config-dir ../.clj-kondo --lint src/",
    "lint:js": "exit 0",
    "check-fmt:clj": "cljfmt check --parallel=true src/ test/",
    "check-fmt:js": "prettier -c src/**/*.js",
    "fmt:clj": "cljfmt fix --parallel=true src/ test/",
    "fmt:js": "prettier -c src/**/*.js -w",
    "lint": "pnpm run lint:clj",
    "watch:test": "concurrently \"clojure -M:dev:shadow-cljs watch test\" \"nodemon -C -d 2 -w target/tests/ --exec 'node target/tests/test.js'\"",
    "build:test": "clojure -M:dev:shadow-cljs compile test",
    "test": "pnpm run build:test && node target/tests/test.js",
    "test:quiet": "node ./scripts/test-quiet.js"
  }
}
