{:deps {:aliases [:dev]}
 :builds
 {:test
  {:target :esm
   :output-dir "target/tests"
   :runtime :node
   :js-options {:js-provider :import}


   :modules
   {:test {:init-fn common-tests.runner/-main
           :prepend-js ";if (typeof globalThis.navigator?.userAgent === 'undefined') { globalThis.navigator = {userAgent: ''}; };"}}}

  :bench
  {:target :node-script
   :output-to "target/bench.js"
   :output-dir "target/bench/"
   :main bench/main
   :devtools {:autoload false}

   :compiler-options
   {:output-feature-set :es-next
    :output-wrapper false}}

  ;; Engine for common/scripts/tokenscript-bench (see dev/tokenscript_bench.cljc)
  :tokenscript-bench
  {:target :node-script
   :output-to "target/tokenscript-bench/engine.cjs"
   :output-dir "target/tokenscript-bench/out"
   :main tokenscript-bench/main
   :devtools {:autoload false}

   :compiler-options
   {:output-feature-set :es-next}}}}


