// CSS rgb() and rgba()
// https://www.w3.org/TR/css-color-4/#rgb-functions
//
// Accepts the CSS syntaxes, so color values written for CSS (and
// accepted by StyleDictionary) keep working:
//
//   rgb(255, 0, 0)          rgb(255 0 0)
//   rgb(100%, 0%, 0%)       rgba(255, 0, 0, 0.5)
//   rgba(255 0 0 50%)       rgba({color.primary}, 0.5)
//
// Channels are numbers (0-255) or percentages; they are clamped to
// 0-255 and rounded like CSS does. The alpha is a number (0-1) or a
// percentage, clamped to 0-1; an alpha of 1 makes the color opaque. A
// color as first argument keeps its channels and takes the alpha.
//
// The slash alpha syntax (`rgb(255 0 0 / 50%)`) is not supported: the
// slash is a division in tokenscript.
//
// Input:  List of arguments
// Output: Color.Rgb

variable args: List = {input};
variable parts: List = args;
if (args.length() == 1 && is_list(args.get(0))) [
  parts = args.get(0);
];

variable output: Color.Rgb;
variable alpha_index: Number = 3;

if (is_color(parts.get(0))) [
  output = parts.get(0).to.rgb();
  alpha_index = 1;
] else [
  // Fewer than three channels fail on `channels.get` below.
  variable channels: List;
  variable channel: Number = 0;
  for part, index in parts [
    if (index < 3) [
      if (type(part) == "%") [
        channel = part.to_number() * 255 / 100;
      ] else [
        channel = part;
      ];
      channels.append(round(min(max(channel, 0), 255)));
    ];
  ];

  output.r = channels.get(0);
  output.g = channels.get(1);
  output.b = channels.get(2);
];

if (parts.length() > alpha_index) [
  variable alpha: Number = 1;
  if (type(parts.get(alpha_index)) == "%") [
    alpha = parts.get(alpha_index).to_number() / 100;
  ] else [
    alpha = parts.get(alpha_index);
  ];
  alpha = min(max(alpha, 0), 1);
  if (alpha < 1) [
    output.alpha = alpha;
  ] else [
    output.alpha = null;
  ];
];

return output;
