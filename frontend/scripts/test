#!/usr/bin/env bash

set -ex
pnpm install;

# Fast JS package unit tests (no wasm/browser needed)
pnpm --filter @penpot/draft-js test;

# Build render wasm binary
pushd ../render-wasm;
./build
popd

pnpm run lint:scss;
pnpm run test;

# Mousetrap JS unit tests (node:test, zero deps)
pushd packages/mousetrap;
pnpm test;
popd
