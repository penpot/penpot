{
  "name": "@penpot/text-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "src/editor/TextEditor.js",
  "scripts": {
    "dev": "vite",
    "coverage": "vitest run --coverage",
    "wasm:update": "mkdir -p src/wasm && cp ../resources/public/js/render-wasm.wasm ./src/wasm/render-wasm.wasm && cp ../resources/public/js/render-wasm.js ./src/wasm/render-wasm.js",
    "test": "vitest --run",
    "fmt:js": "pnpx prettier -c src/**/*.js",
    "test:watch": "vitest",
    "test:watch:ui": "vitest --ui",
    "test:watch:e2e": "vitest --browser"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.3",
    "@vitest/browser": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "canvas": "^3.2.3",
    "esbuild": "^0.28.0",
    "jsdom": "^30.0.1",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.0",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
