{
  "name": "@penpot/text-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "src/editor/TextEditor.js",
  "scripts": {
    "dev": "vite",
    "coverage": "vitest run --coverage",
    "wasm:update": "mkdir -p src/wasm && cp ../resources/public/js/render-wasm.wasm ./src/wasm/render-wasm.wasm && cp ../resources/public/js/render-wasm.js ./src/wasm/render-wasm.js",
    "test": "vitest --run",
    "fmt:js": "pnpx prettier -c src/**/*.js",
    "test:watch": "vitest",
    "test:watch:ui": "vitest --ui",
    "test:watch:e2e": "vitest --browser"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.3",
    "@vitest/browser": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "canvas": "^3.2.3",
    "esbuild": "^0.28.0",
    "jsdom": "^30.0.1",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.0",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
