# Copy to .env and fill in. Real environment variables win over this file.

# Penpot instance
PENPOT_BASE_URL=http://localhost:3450

# Authentication: either email + password, or an access token.
PENPOT_EMAIL=profile1@example.com
PENPOT_PASSWORD=123123
# PENPOT_ACCESS_TOKEN=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=upstage/solar-decide-flash
# OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
